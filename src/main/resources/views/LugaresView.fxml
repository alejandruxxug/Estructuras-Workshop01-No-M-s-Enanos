<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.LugarController"
      VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

    <!-- Section Header -->
    <HBox styleClass="section-header" alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label fx:id="sectionTitle" text="Lugares" styleClass="section-title"/>
            <Label fx:id="sectionSubtitle" text="0 registrados" styleClass="section-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Registrar Nuevo" styleClass="btn-primary"
                onAction="#onNuevo"/>
    </HBox>

    <!-- Filter Bar -->
    <HBox styleClass="filter-bar" spacing="12">
        <Button text="⟳" styleClass="btn-reload" onAction="#onReload"/>
        <ComboBox fx:id="filterTipoLugar" styleClass="combo-box-dark"
                  promptText="Tipo de Lugar" prefWidth="200"
                  onAction="#onFilter"/>
        <ComboBox fx:id="filterCiudad" styleClass="combo-box-dark"
                  promptText="Ciudad" prefWidth="200"
                  onAction="#onFilter"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Content: Table + Form overlay -->
    <StackPane VBox.vgrow="ALWAYS">
        <VBox styleClass="table-container" VBox.vgrow="ALWAYS">
            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNombre" text="NOMBRE" prefWidth="180"/>
                    <TableColumn fx:id="colCiudad" text="CIUDAD" prefWidth="140"/>
                    <TableColumn fx:id="colDireccion" text="DIRECCIÓN" prefWidth="200"/>
                    <TableColumn fx:id="colCapacidad" text="CAPACIDAD" prefWidth="110"/>
                    <TableColumn fx:id="colTipo" text="TIPO" prefWidth="120"/>
                    <TableColumn fx:id="colAcciones" text="ACCIONES" prefWidth="220"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Slide-in form panel -->
        <VBox fx:id="formPanel" styleClass="form-panel" alignment="TOP_RIGHT"
              visible="false" managed="false"
              StackPane.alignment="CENTER_RIGHT">
            <HBox styleClass="form-header" alignment="CENTER_LEFT" spacing="12">
                <Button text="✕" styleClass="form-close-btn" onAction="#onCancelForm"/>
                <Label fx:id="formTitle" text="Registrar Lugar" styleClass="form-header-title"/>
            </HBox>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
                <VBox styleClass="form-body" spacing="2">
                    <Label text="Nombre" styleClass="form-label"/>
                    <TextField fx:id="fieldNombre" styleClass="text-field-dark"
                               promptText="Nombre del lugar"/>
                    <Label text="Dirección" styleClass="form-label"/>
                    <TextField fx:id="fieldDireccion" styleClass="text-field-dark"
                               promptText="Dirección completa"/>
                    <Label text="Ciudad" styleClass="form-label"/>
                    <TextField fx:id="fieldCiudad" styleClass="text-field-dark"
                               promptText="Ciudad"/>
                    <Label text="Capacidad máxima" styleClass="form-label"/>
                    <TextField fx:id="fieldCapacidad" styleClass="text-field-dark"
                               promptText="Ej: 500"/>
                    <Label text="Tipo de Lugar" styleClass="form-label"/>
                    <ComboBox fx:id="fieldTipoLugar" styleClass="combo-box-dark"
                              prefWidth="380" promptText="Seleccionar tipo"/>
                </VBox>
            </ScrollPane>
            <HBox styleClass="form-footer" spacing="12">
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Cancelar" styleClass="btn-outline" onAction="#onCancelForm"/>
                <Button text="Guardar" styleClass="btn-primary" onAction="#onSaveForm"/>
            </HBox>
        </VBox>
    </StackPane>
</VBox>
