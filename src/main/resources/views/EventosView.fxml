<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.EventoController"
      VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

    <!-- Section Header -->
    <HBox styleClass="section-header" alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label fx:id="sectionTitle" text="Eventos" styleClass="section-title"/>
            <Label fx:id="sectionSubtitle" text="0 registrados" styleClass="section-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Registrar Nuevo" styleClass="btn-primary"
                onAction="#onNuevo"/>
    </HBox>

    <!-- Filter Bar with pill toggles -->
    <HBox styleClass="filter-bar" spacing="12" alignment="CENTER_LEFT">
        <fx:define>
            <ToggleGroup fx:id="tipoFilterGroup"/>
        </fx:define>
        <ToggleButton fx:id="filterTodos" text="TODOS" styleClass="pill-toggle"
                      toggleGroup="$tipoFilterGroup" selected="true"
                      onAction="#onFilter"/>
        <ToggleButton fx:id="filterPublico" text="PÚBLICO" styleClass="pill-toggle"
                      toggleGroup="$tipoFilterGroup"
                      onAction="#onFilter"/>
        <ToggleButton fx:id="filterPrivado" text="PRIVADO" styleClass="pill-toggle"
                      toggleGroup="$tipoFilterGroup"
                      onAction="#onFilter"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Content: Table + Form overlay -->
    <StackPane VBox.vgrow="ALWAYS">
        <VBox styleClass="table-container" VBox.vgrow="ALWAYS">
            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNombre" text="NOMBRE" prefWidth="180"/>
                    <TableColumn fx:id="colFecha" text="FECHA" prefWidth="120"/>
                    <TableColumn fx:id="colTipo" text="TIPO" prefWidth="140"/>
                    <TableColumn fx:id="colLugar" text="LUGAR" prefWidth="160"/>
                    <TableColumn fx:id="colParticipantes" text="PARTICIPANTES" prefWidth="120"/>
                    <TableColumn fx:id="colAcciones" text="ACCIONES" prefWidth="220"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Slide-in form panel -->
        <VBox fx:id="formPanel" styleClass="form-panel" alignment="TOP_RIGHT"
              visible="false" managed="false"
              StackPane.alignment="CENTER_RIGHT">
            <HBox styleClass="form-header" alignment="CENTER_LEFT" spacing="12">
                <Button text="✕" styleClass="form-close-btn" onAction="#onCancelForm"/>
                <Label fx:id="formTitle" text="Registrar Evento" styleClass="form-header-title"/>
            </HBox>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
                <VBox styleClass="form-body" spacing="2">
                    <Label text="Tipo de Evento" styleClass="form-label"/>
                    <HBox spacing="8">
                        <fx:define>
                            <ToggleGroup fx:id="tipoEventoGroup"/>
                        </fx:define>
                        <ToggleButton fx:id="btnTipoPublico" text="Público"
                                      styleClass="pill-toggle"
                                      toggleGroup="$tipoEventoGroup" selected="true"
                                      onAction="#onTipoChanged"/>
                        <ToggleButton fx:id="btnTipoPrivado" text="Privado"
                                      styleClass="pill-toggle"
                                      toggleGroup="$tipoEventoGroup"
                                      onAction="#onTipoChanged"/>
                    </HBox>

                    <Label text="Nombre" styleClass="form-label"/>
                    <TextField fx:id="fieldNombre" styleClass="text-field-dark"
                               promptText="Nombre del evento"/>
                    <Label text="Fecha" styleClass="form-label"/>
                    <DatePicker fx:id="fieldFecha" prefWidth="380"/>
                    <Label text="Lugar" styleClass="form-label"/>
                    <ComboBox fx:id="fieldLugar" styleClass="combo-box-dark"
                              prefWidth="380" promptText="Seleccionar lugar"/>

                    <!-- Public-only fields -->
                    <VBox fx:id="publicFields" spacing="2">
                        <Label text="Capacidad" styleClass="form-label"/>
                        <TextField fx:id="fieldCapacidad" styleClass="text-field-dark"
                                   promptText="Capacidad máxima"/>
                        <Label text="Patrocinador" styleClass="form-label"/>
                        <TextField fx:id="fieldPatrocinador" styleClass="text-field-dark"
                                   promptText="Nombre del patrocinador"/>
                    </VBox>

                    <!-- Private-only fields -->
                    <VBox fx:id="privateFields" spacing="2" visible="false" managed="false">
                        <Label text="Cliente" styleClass="form-label"/>
                        <TextField fx:id="fieldCliente" styleClass="text-field-dark"
                                   promptText="Nombre del cliente"/>
                        <Label text="Nivel de Confidencialidad" styleClass="form-label"/>
                        <ComboBox fx:id="fieldConfidencialidad" styleClass="combo-box-dark"
                                  prefWidth="380" promptText="Seleccionar nivel"/>
                    </VBox>

                    <Label text="Modelos" styleClass="form-label"/>
                    <ListView fx:id="fieldModelos" styleClass="list-view-dark"
                              prefHeight="120"/>
                    <Label text="Fotógrafos" styleClass="form-label"/>
                    <ListView fx:id="fieldFotografos" styleClass="list-view-dark"
                              prefHeight="120"/>
                </VBox>
            </ScrollPane>
            <HBox styleClass="form-footer" spacing="12">
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Cancelar" styleClass="btn-outline" onAction="#onCancelForm"/>
                <Button text="Guardar" styleClass="btn-primary" onAction="#onSaveForm"/>
            </HBox>
        </VBox>
    </StackPane>
</VBox>
